+                    // ── Changed elsewhere since it was opened ─────────────────────
+                    pendingConflict?.let { conflicted ->
+                        AlertDialog(
+                            onDismissRequest = { pendingConflict = null },
+                            title = { Text("File changed elsewhere") },
